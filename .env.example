# Copy this file to .env and fill in DATABASE_URL.
#
# Solve Trainer needs a Postgres database, both for local dev and for the
# Vercel deployment — this is what makes your practice history survive
# restarts and follow you between your laptop and the deployed site. Any
# standard Postgres connection string works. Two free options that take
# a couple of minutes to set up:
#
#   Neon        https://neon.tech           (also what Vercel's own
#                                             "Postgres" storage product
#                                             is built on)
#   Supabase    https://supabase.com
#
# After creating a database, copy its connection string here. It looks like:
#   postgres://user:password@host/dbname?sslmode=require
#
# For the deployed site, set the same variable in the Vercel project's
# Settings -> Environment Variables, not in this file (this file is never
# committed or uploaded).

DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
